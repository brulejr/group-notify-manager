.gradle/
build/

# Stray jars stay out, but the Gradle wrapper must be committed so a fresh
# clone can build without Gradle installed. Order matters: the negation has to
# follow the broad rule, since the last matching pattern wins.
*.jar
!gradle/wrapper/gradle-wrapper.jar

.idea/
*.iml
.vscode/
.kotlin/

# Local secrets
.env
.env.*

# Plugin jars dropped in for a local run; see docs/plugins.md.
/plugins-dir/*.jar

# Claude Code: CLAUDE.md and .claude/ are committed deliberately, but
# settings.local.json is per-developer and can hold tokens / MCP credentials.
.claude/settings.local.json

**/resources/application-local.yml
